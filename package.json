{
  "name": "professor-kauri",
  "version": "5.0.0",
  "type": "module",
  "description": "Monorepo for the Professor Kauri framework, bot and related utilities",
  "scripts": {
    "prebuild": "npm run clean && npm install --production=false",
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "clean": "npx rimraf dist",
    "lint": "npx eslint src/**/*.ts",
    "lint:fix": "npx eslint src/**/*.ts --fix",
    "start": "node --enable-source-maps --env-file=.env dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monbrey/professor-kauri.git"
  },
  "author": "monbrey",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/monbrey/professor-kauri/issues"
  },
  "homepage": "https://github.com/monbrey/professor-kauri#readme",
  "dependencies": {
    "@discordjs/core": "^2.0.1",
    "@types/node": "^22.13.10",
    "common-tags": "^1.8.2",
    "dice-coefficient": "^2.1.1",
    "eslint-config-neon": "^0.2.4",
    "log4js": "^6.9.1",
    "pokeapi-typescript": "^3.0.0",
    "postgres": "^3.4.5",
    "urpg.js": "^2.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/common-tags": "^1.8.4",
    "eslint": "^9.22.0",
    "globals": "^16.0.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0"
  },
  "overrides": {
    "eslint-plugin-mdx": "3.2.0"
  }
}
